{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "aihc-www",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker runs before the assets so that it can redirect www.aihc.app.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "aihc.app", "custom_domain": true },
    { "pattern": "www.aihc.app", "custom_domain": true }
  ]
}
